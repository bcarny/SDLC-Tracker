# Database (required). Railway provides DATABASE_URL when you add PostgreSQL.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Server
PORT=3000
NODE_ENV=development

# Optional: ServiceNow (for sync)
# SERVICENOW_BASE_URL=https://your-instance.service-now.com
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=

# Optional: Power BI (for export)
# POWERBI_CLIENT_ID=
# POWERBI_CLIENT_SECRET=
# POWERBI_TENANT_ID=
# POWERBI_WORKSPACE_ID=
