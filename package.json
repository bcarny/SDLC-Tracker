{
  "name": "sdlc-maturity-tracker",
  "version": "0.1.0",
  "description": "FFIEC-aligned SDLC maturity tracker for applications and teams",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:migrate": "prisma migrate deploy && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "hono": "^4.11.7"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^4.0.18"
  }
}